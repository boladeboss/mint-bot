{
  "name": "mint-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-chain NFT minting bot with Telegram interface",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "setup": "tsx scripts/setup-wallets.ts",
    "test:connection": "tsx scripts/test-connection.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "@scure/bip32": "^1.5.0",
    "@scure/bip39": "^1.4.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "sql.js": "^1.11.0",
    "telegraf": "^4.16.0",
    "viem": "^2.21.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
